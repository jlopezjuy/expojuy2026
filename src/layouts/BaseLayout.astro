---
import '../styles/global.css';
// Preload the two Ambit weights used for first paint (body Regular, heading
// SemiBold). Astro fingerprints them; the @font-face url() resolves to the
// same hashed asset.
import ambitRegular from '../fonts/ambit-regular.woff2';
import ambitSemibold from '../fonts/ambit-semibold.woff2';
import { event } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'es-AR' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://expojuy.com.ar');

// Sprint 6.2 — Schema.org Event, only on the page that represents the event.
// Field order matches the mockup-approved data in src/data/site.ts; nothing is
// invented. Dates derive from `event.datesLong` ("SEPTIEMBRE 2026") and
// `event.datesShort` ("17 AL 20"). The day numbers come from `agendaDays`.
const isHome = Astro.url.pathname === '/';
const ogImage = new URL('/images/photos/hero-crowd.jpg', Astro.site ?? 'https://expojuy.com.ar').href;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${event.name} ${event.year}`,
  startDate: '2026-10-09T10:00:00-03:00',
  endDate: '2026-10-12T22:00:00-03:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: [ogImage],
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.city,
      addressRegion: 'Jujuy',
      addressCountry: 'AR',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Cámara de Comercio Exterior de Jujuy',
    url: 'https://expojuy.camcomexjujuy.com.ar/',
  },
  offers: {
    '@type': 'AggregateOffer',
    url: new URL('/entradas', Astro.site ?? 'https://expojuy.com.ar').href,
    priceCurrency: 'ARS',
    lowPrice: '0',
    highPrice: '10000',
    validFrom: '2026-03-01',
    availability: 'https://schema.org/InStock',
  },
  description: event.tagline,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07121e" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      isHome && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(eventLd)} />
      )
    }

    <!-- Local Ambit fonts (see src/styles/global.css @font-face). -->
    <link rel="preload" href={ambitRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ambitSemibold} as="font" type="font/woff2" crossorigin />

    {/* Set before first paint so scroll-reveal elements never flash for no-JS users. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <slot />

    <script>
      import '../scripts/enhance';
    </script>
  </body>
</html>
