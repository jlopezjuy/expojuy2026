---
/**
 * ExpoJuy wordmark.
 *
 * Mark: the OFFICIAL ExpoJuy 2026 isologotipo (recursos/EXPOJUY_Logo2026/RGB/
 * expojuy26_isologotipo.png), cropped to a transparent asset. This replaces the
 * previous hand-drawn SVG interpretation — no invented geometry or colours.
 * Wordmark "EXPOJUY 2026" is typography set in the local Ambit family.
 */
import logoMark from '../../assets/expojuy-isologotipo.png';

interface Props {
  /** `light` for dark backgrounds, `dark` for the cream sections. */
  tone?: 'light' | 'dark';
  class?: string;
  /** Rendered as a link when an href is given. */
  href?: string;
}

const { tone = 'light', class: className = '', href } = Astro.props;
const wordColor = tone === 'light' ? 'text-white' : 'text-night';
const Tag = href ? 'a' : 'div';
---

<Tag
  {...href ? { href, 'aria-label': 'ExpoJuy 2026 — inicio' } : {}}
  class={`inline-flex items-center gap-2.5 ${className}`}
>
  <img
    src={logoMark.src}
    alt="ExpoJuy 2026"
    class="h-9 w-auto shrink-0"
    width={logoMark.width}
    height={logoMark.height}
    loading="eager"
    decoding="async"
  />

  <span class={`leading-none ${wordColor}`}>
    <span class="block text-[1.35rem] font-extrabold tracking-[0.02em]">
      EXPOJUY
    </span>
    <span class="block text-[0.95rem] font-medium tracking-[0.18em] opacity-90">2026</span>
  </span>
</Tag>
