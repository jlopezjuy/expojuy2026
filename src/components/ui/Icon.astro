---
/** Thin line-icon set, drawn to match the outline style of the reference. */
interface Props {
  name:
    | 'briefcase'
    | 'compass'
    | 'culture'
    | 'gear'
    | 'experience'
    | 'arrow-right'
    | 'arrow-down'
    | 'instagram'
    | 'facebook'
    | 'x'
    | 'youtube'
    | 'linkedin'
    | 'search';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'briefcase' && (
      <>
        <rect x="2.5" y="7" width="19" height="13" rx="2" />
        <path d="M8.5 7V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2M2.5 12h19" />
      </>
    )
  }
  {
    name === 'compass' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="m15.5 8.5-2 5-5 2 2-5z" />
      </>
    )
  }
  {
    name === 'culture' && (
      <>
        <path d="M3 21V8l9-5 9 5v13" />
        <path d="M3 21h18M9 21v-6h6v6M9.5 11h5" />
      </>
    )
  }
  {
    name === 'gear' && (
      <>
        <circle cx="12" cy="12" r="3.2" />
        <path d="M12 2.5v2.6M12 18.9v2.6M21.5 12h-2.6M5.1 12H2.5M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8M18.7 18.7l-1.8-1.8M7.1 7.1 5.3 5.3" />
      </>
    )
  }
  {
    name === 'experience' && (
      <>
        <path d="M12 3v18M3 12h18" />
        <path d="M12 3c3 3 3 15 0 18M12 3C9 6 9 18 12 21" />
        <circle cx="12" cy="12" r="3" />
      </>
    )
  }
  {name === 'arrow-right' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {name === 'facebook' && <path d="M14.5 8.5h2.2V5.6h-2.4c-2.3 0-3.6 1.4-3.6 3.7v1.9H8.5v3h2.2V21h3.1v-6.8h2.3l.4-3h-2.7v-1.5c0-.8.3-1.2 1.2-1.2z" />}
  {name === 'x' && <path d="M4 4l7.2 9.3L4.4 20h2.1l5.6-5.9 4.4 5.9H20l-7.5-9.7L19.4 4h-2.1l-5.2 5.5L8 4z" />}
  {
    name === 'youtube' && (
      <>
        <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
        <path d="m10.5 9.5 5 2.5-5 2.5z" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M7.3 10.4V17M7.3 7.4v.1M11.4 17v-3.6a2.2 2.2 0 0 1 4.4 0V17" />
      </>
    )
  }
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.35-4.35" />
      </>
    )
  }
</svg>
