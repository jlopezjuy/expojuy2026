---
import { event, footerColumns } from '../../data/site';
import Container from '../layout/Container.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
---

<footer class="bg-night pt-14 pb-8 text-white lg:pt-16">
  <Container>
    {/* Three columns only from `xl`: below that the middle nav needs the full
        width for its own three sub-columns. */}
    <div class="grid gap-12 xl:grid-cols-[minmax(0,15rem)_minmax(0,1fr)_minmax(0,20rem)] xl:gap-14">
      <!-- Brand -->
      <div>
        <Logo href="#top" tone="light" />
        <p class="mt-6 max-w-[22ch] text-sm leading-relaxed text-white/65">{event.tagline}</p>

        {/* Sprint 2.2: iconos de redes retirados hasta que la organización provea
            los handles reales (ver `socials` en src/data/site.ts). */}
      </div>

      <!-- Link columns -->
      <nav aria-label="Enlaces del sitio" class="grid gap-10 sm:grid-cols-3">
        {
          footerColumns.map((column) => (
            <div>
              <h2 class="eyebrow font-sans text-white/50">{column.title}</h2>
              <ul class="mt-5 flex flex-col gap-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[0.85rem] text-white/80 transition-colors duration-300 hover:text-gold-bright"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <!-- Newsletter -->
      <div class="max-w-[28rem] xl:max-w-none xl:border-l xl:border-white/12 xl:pl-14">
        <h2 class="font-sans text-base font-bold text-white">Recibí novedades de ExpoJuy</h2>
        {/* TODO: no hay backend. Conectar `action` al proveedor de newsletter real. */}
        <form
          action="#"
          class="mt-5 flex items-center gap-2 border border-white/25 p-1.5 transition-colors focus-within:border-white/70"
        >
          <label for="newsletter-email" class="sr-only">Tu email</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Tu email"
            class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-sm text-white placeholder:text-white/45 focus:outline-none"
          />
          <button
            type="submit"
            class="grid h-10 w-10 shrink-0 place-items-center text-white transition-colors duration-300 hover:text-gold-bright"
          >
            <span class="sr-only">Suscribirme</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
        </form>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-center gap-4 border-t border-white/10 pt-6 text-center sm:flex-row sm:justify-center sm:gap-10"
    >
      <p class="text-[0.72rem] text-white/50">
        © 2026 ExpoJuy. Todos los derechos reservados.
      </p>
      {/* Sprint 2.3: enlaces legales ("Términos y condiciones", "Política de
          privacidad") retirados — no existen las páginas todavía (ver `legalLinks`
          en src/data/site.ts). */}
    </div>
  </Container>
</footer>
