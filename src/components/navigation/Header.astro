---
import { nav } from '../../data/site';
import Container from '../layout/Container.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import Logo from '../ui/Logo.astro';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-500 ease-out data-[stuck]:border-b data-[stuck]:border-white/10 data-[stuck]:bg-night/90 data-[stuck]:backdrop-blur-md"
>
  <Container class="flex items-center justify-between gap-6 py-4 lg:py-5">
    <Logo href="#top" tone="light" />

    <nav aria-label="Navegación principal" class="hidden xl:block">
      <ul class="flex items-center gap-8 2xl:gap-10">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-disabled={item.placeholder ? 'true' : undefined}
                class="relative block py-2 text-[0.68rem] font-bold tracking-[0.16em] text-white/85 uppercase transition-colors duration-300 hover:text-white after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-gold-bright after:transition-transform after:duration-300 after:content-[''] hover:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      {/* Wrapped rather than class-toggled: ButtonLink's own `inline-flex`
          would win the display cascade against a `hidden` utility. */}
      <div class="hidden md:block">
        <ButtonLink href="#participar" variant="pill">Quiero participar</ButtonLink>
      </div>

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid h-11 w-11 place-items-center text-white xl:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <span aria-hidden="true" class="flex w-6 flex-col gap-[5px]">
          <span class="h-px w-full bg-current transition-transform duration-300"></span>
          <span class="h-px w-full bg-current transition-opacity duration-300"></span>
          <span class="h-px w-full bg-current transition-transform duration-300"></span>
        </span>
      </button>
    </div>
  </Container>

  <!-- Mobile panel. Hidden from AT and pointer events until opened. -->
  <div
    id="mobile-nav"
    hidden
    class="border-t border-white/10 bg-night/97 backdrop-blur-lg xl:hidden"
  >
    <Container class="py-8">
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block border-b border-white/10 py-4 text-sm font-bold tracking-[0.16em] text-white uppercase"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ButtonLink href="#participar" variant="solid" class="mt-8 w-full">
        Quiero participar
      </ButtonLink>
    </Container>
  </div>
</header>

<style>
  #nav-toggle[aria-expanded='true'] span[aria-hidden] > span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #nav-toggle[aria-expanded='true'] span[aria-hidden] > span:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle[aria-expanded='true'] span[aria-hidden] > span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
