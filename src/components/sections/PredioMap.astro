---
import { planoZones } from '../../data/plano';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Heading level, since this section is its own page (h1) yet reuse-safe. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h1' } = Astro.props;
---

<section class="bg-cream pt-28 pb-16 sm:pt-32 lg:pt-36 lg:pb-24" aria-labelledby="plano-title">
  <Container width="normal">
    <div class="reveal">
      <SectionHeading
        eyebrow="Mapa y Distribución"
        title="Plano Oficial del"
        accent="Predio Ferial."
        accentColor="magenta"
        as={headingLevel}
        id="plano-title"
      />
      <p class="mt-6 max-w-[58ch] text-body text-night/75">
        Recorré los pabellones temáticos, auditorios, sectores gastronómicos y puestos de stands de ExpoJuy 2026. Hacé clic en cualquier zona para ver su información y expositores asignados.
      </p>
    </div>

    <div data-venue-map class="reveal relative mt-10" style="--reveal-delay:120ms">
      {/* Contenedor del Mapa Vectorial */}
      <div class="relative aspect-[1000/620] w-full overflow-hidden rounded-card border border-night/10 bg-cream-deep/60 p-2 sm:p-4">
        <svg
          role="img"
          aria-labelledby="plano-svg-title"
          viewBox="0 0 1000 620"
          preserveAspectRatio="none"
          class="h-full w-full"
        >
          <title id="plano-svg-title">
            Plano interactivo de pabellones y zonas de ExpoJuy 2026 en el Predio Ferial Jujuy.
          </title>
          
          {/* Límite perimetral del predio */}
          <rect x="20" y="30" width="960" height="560" rx="24" fill="var(--color-cream)" stroke="var(--color-night)" stroke-opacity="0.15" stroke-width="2" />
          
          {/* Vías peatonales principales */}
          <path d="M160 310H920" stroke="var(--color-night)" stroke-opacity="0.1" stroke-width="4" stroke-dasharray="10 8" fill="none" />
          <path d="M520 180V470" stroke="var(--color-night)" stroke-opacity="0.1" stroke-width="4" stroke-dasharray="10 8" fill="none" />

          {/* Renderizado vectorial de cada pabellón/zona */}
          {
            planoZones.map((zone) => (
              <g id={`svg-zone-${zone.id}`} class="transition-opacity duration-300">
                <rect
                  x={zone.svg.x}
                  y={zone.svg.y}
                  width={zone.svg.width}
                  height={zone.svg.height}
                  rx="12"
                  fill={zone.svg.color}
                  fill-opacity="0.16"
                  stroke={zone.svg.color}
                  stroke-opacity="0.45"
                  stroke-width="2"
                />
                <text
                  x={zone.svg.x + zone.svg.width / 2}
                  y={zone.svg.y + zone.svg.height / 2 + 4}
                  text-anchor="middle"
                  fill="var(--color-night)"
                  fill-opacity="0.75"
                  font-size="11"
                  font-weight="700"
                  letter-spacing="0.05em"
                  class="select-none uppercase pointer-events-none"
                >
                  {zone.pabellonBadge}
                </text>
              </g>
            ))
          }
        </svg>

        {/* Botones/Marcadores interactivos superpuestos */}
        {
          planoZones.map((zone, i) => (
            <button
              type="button"
              data-zone={zone.id}
              data-zone-name={zone.name}
              data-zone-badge={zone.pabellonBadge}
              data-zone-note={zone.note}
              data-zone-stands={zone.stands.join(', ')}
              data-zone-expositores={zone.expositores.join(', ')}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`${zone.name}: ${zone.note}`}
              class={`absolute z-10 grid h-8 w-8 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white font-display text-xs font-bold shadow-md transition-all duration-200 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-magenta ${
                i === 0 ? 'bg-magenta text-white ring-2 ring-magenta/40' : 'bg-night text-cream hover:bg-magenta'
              }`}
              style={`left:${zone.x}%; top:${zone.y}%`}
            >
              {i + 1}
              <span class="sr-only">{zone.name}</span>
            </button>
          ))
        }
      </div>

      <p id="plano-info" class="sr-only" role="status" aria-live="polite">
        {planoZones[0]?.name}: {planoZones[0]?.note}
      </p>

      {/* Panel dinámico de detalles de la zona activa */}
      <div
        id="zone-detail-card"
        class="mt-6 rounded-card border border-night/15 bg-cream-deep/80 p-6 shadow-sm transition-all duration-300 sm:p-8"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span
            id="zone-card-badge"
            class="rounded bg-night/10 px-3 py-1 text-[0.68rem] font-bold tracking-wider text-night uppercase"
          >
            {planoZones[0]?.pabellonBadge}
          </span>
          <a
            href="/expositores"
            class="inline-flex items-center gap-1.5 text-[0.68rem] font-bold tracking-wider text-night/80 uppercase transition-colors hover:text-magenta"
          >
            Ver Directorio de Expositores
            <Icon name="arrow-right" class="h-3.5 w-3.5 text-magenta" />
          </a>
        </div>

        <h2 id="zone-card-title" class="font-display mt-3 text-xl font-bold text-night">
          {planoZones[0]?.name}
        </h2>

        <p id="zone-card-note" class="mt-2 text-body text-night/80">
          {planoZones[0]?.note}
        </p>

        <div class="mt-5 grid gap-4 border-t border-night/10 pt-4 sm:grid-cols-2">
          <div>
            <p class="text-[0.62rem] font-bold tracking-wider text-night/60 uppercase">Stands y Puestos:</p>
            <p id="zone-card-stands" class="mt-1 text-xs font-semibold text-night/90">
              {planoZones[0]?.stands.join(', ')}
            </p>
          </div>
          <div>
            <p class="text-[0.62rem] font-bold tracking-wider text-night/60 uppercase">Expositores / Entidades:</p>
            <p id="zone-card-expositores" class="mt-1 text-xs font-semibold text-night/90">
              {planoZones[0]?.expositores.join(', ')}
            </p>
          </div>
        </div>
      </div>

      {/* Listado accesible de todas las zonas */}
      <div class="mt-12">
        <h2 class="font-display text-lg font-bold text-night">Todas las Zonas y Pabellones del Predio</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            planoZones.map((zone, i) => (
              <li
                class="reveal flex flex-col justify-between rounded-card border border-night/10 bg-cream-deep/60 p-5 transition-colors hover:border-night/30"
                style={`--reveal-delay:${(i % 4) * 60}ms`}
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-night font-display text-xs font-bold text-cream">
                      {i + 1}
                    </span>
                    <span class="rounded bg-night/5 px-2 py-0.5 text-[0.58rem] font-bold tracking-wider text-night/80 uppercase">
                      {zone.pabellonBadge}
                    </span>
                  </div>
                  <h3 class="font-display mt-2.5 text-base font-bold text-night leading-snug">{zone.name}</h3>
                  <p class="mt-1.5 text-xs text-night/75 leading-relaxed">{zone.note}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
