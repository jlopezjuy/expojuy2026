---
import { event } from '../../data/site';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Heading level, since this section is its own page (h1) yet reuse-safe. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h1' } = Astro.props;

const fields = [
  { label: 'Nombre y Apellido', name: 'nombre', type: 'text', autocomplete: 'name', maxlength: 120, required: true },
  { label: 'Correo Electrónico', name: 'email', type: 'email', autocomplete: 'email', maxlength: 200, required: true },
  { label: 'Asunto o Motivo', name: 'asunto', type: 'text', autocomplete: 'off', maxlength: 200, required: true },
] as const;
---

<section class="bg-cream pb-16 lg:pb-20" aria-labelledby="contacto-title">
  <Container class="grid gap-12 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-16">
    <div class="reveal">
      <SectionHeading
        eyebrow="Contacto"
        title="Ponete en contacto."
        accentColor="teal"
        as={headingLevel}
        id="contacto-title"
      />
      <p class="mt-6 max-w-[44ch] text-body text-night/75">
        Consultas de expositores, acreditación comercial, prensa o atención al visitante: escribinos y el equipo de ExpoJuy te responderá a la brevedad.
      </p>

      <dl class="mt-10 flex flex-col gap-6">
        <div>
          <dt class="eyebrow text-night/60">Fechas</dt>
          <dd class="mt-2 font-display text-title text-night">17 al 20 de septiembre de 2026</dd>
        </div>
        <div>
          <dt class="eyebrow text-night/60">Lugar</dt>
          <dd class="mt-2 font-display text-title text-night">{event.venue}</dd>
          <dd class="mt-1 text-body text-night/70">{event.city}</dd>
        </div>
        <div>
          <dt class="eyebrow text-night/60">Sitio oficial</dt>
          <dd class="mt-2">
            <a
              href="https://expojuy.camcomexjujuy.com.ar/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body text-night underline decoration-magenta/50 underline-offset-4 transition-colors duration-300 hover:text-magenta"
            >
              expojuy.camcomexjujuy.com.ar
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="reveal" style="--reveal-delay:120ms">
      <form
        id="contacto-form"
        method="POST"
        action="#contacto-form"
        class="relative flex flex-col gap-5 rounded-card border border-night/10 bg-cream-deep/60 p-6 sm:p-8"
      >
        {
          fields.map((field) => (
            <div class="flex flex-col gap-1.5">
              <label for={`${field.name}-field`} class="text-[0.68rem] font-bold tracking-[0.14em] text-night/70 uppercase">
                {field.label}
              </label>
              <input
                id={`${field.name}-field`}
                name={field.name}
                type={field.type}
                autocomplete={field.autocomplete}
                maxlength={field.maxlength}
                required={field.required}
                class="min-w-0 rounded-[3px] border border-night/25 bg-cream px-4 py-3 text-body text-night placeholder:text-night/40 transition-colors duration-300 focus:border-night/60 focus:outline-none"
              />
            </div>
          ))
        }

        <div class="flex flex-col gap-1.5">
          <label for="mensaje-field" class="text-[0.68rem] font-bold tracking-[0.14em] text-night/70 uppercase">
            Mensaje
          </label>
          <textarea
            id="mensaje-field"
            name="mensaje"
            rows="5"
            maxlength="2000"
            required
            class="min-w-0 resize-y rounded-[3px] border border-night/25 bg-cream px-4 py-3 text-body text-night placeholder:text-night/40 transition-colors duration-300 focus:border-night/60 focus:outline-none"
          ></textarea>
        </div>

        {/* Honeypot: hidden from people and assistive tech; only bots fill it. */}
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="website-field">No completar este campo</label>
          <input id="website-field" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-4 border-t border-night/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
          <button
            type="submit"
            id="contacto-submit-btn"
            class="group inline-flex items-center justify-center gap-3 text-[0.7rem] font-bold tracking-[0.16em] text-night uppercase transition duration-300 ease-out bg-gold-bright px-7 py-3.5 shadow-[0_10px_30px_-12px_rgba(0,0,0,0.6)] hover:bg-white disabled:cursor-not-allowed disabled:bg-night/15 disabled:text-night/45 disabled:shadow-none"
          >
            <span id="contacto-btn-text">Enviar mensaje</span>
            <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
          </button>

          <p class="text-[0.72rem] leading-relaxed text-night/70">
            Respuesta estimada en menos de 24 horas hábiles.
          </p>
        </div>

        {/* Mensaje de estado accesible */}
        <div
          id="contacto-status"
          role="status"
          aria-live="polite"
          class="hidden rounded border border-teal/30 bg-teal/10 p-4 text-xs font-semibold text-night"
        >
        </div>
      </form>
    </div>
  </Container>
</section>
