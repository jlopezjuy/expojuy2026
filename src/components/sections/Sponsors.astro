---
import { Image } from 'astro:assets';
import { regionalCompanies, regionalCompaniesNotice, regionalCompaniesTitle } from '../../data/regional-companies';
import Container from '../layout/Container.astro';
---

<section class="border-t border-night/10 bg-cream py-8" aria-labelledby="sponsors-title" aria-describedby="regional-companies-notice">
  <Container class="flex flex-col items-center gap-6 lg:flex-row lg:gap-10">
    <h2
      id="sponsors-title"
      class="shrink-0 font-sans text-[0.7rem] font-bold tracking-[0.14em] text-night/70 uppercase"
    >
      {regionalCompaniesTitle}
    </h2>

    {/* La copia visual permite el bucle de escritorio; queda fuera del árbol accesible.
        En pantallas pequeñas la lista es desplazable, sin movimiento automático. */}
    <div class="sponsors-viewport min-w-0 w-full">
      <ul
        class="sponsors-track rail -mx-gutter w-full items-center gap-8 px-gutter lg:mx-0 lg:overflow-visible lg:px-0 lg:[mask-image:none] lg:[-webkit-mask-image:none]"
        tabindex="0"
        aria-label={regionalCompaniesTitle}
      >
        {
          regionalCompanies.map((company) => (
            <li class="flex items-center">
              {company.logo ? (
                <Image
                  src={company.logo}
                  alt={company.name}
                  width={192}
                  class="h-auto w-24 shrink-0 object-contain"
                />
              ) : (
                <span class="text-center text-[0.72rem] leading-tight font-bold tracking-[0.05em] whitespace-nowrap text-night/70 uppercase transition-colors duration-300 hover:text-night/85">
                  {company.name}
                </span>
              )}
            </li>
          ))
        }
      </ul>

      <ul class="sponsors-track sponsors-track--clone items-center gap-8" aria-hidden="true">
        {
          regionalCompanies.map((company) => (
            <li class="flex items-center">
              {company.logo ? (
                <Image
                  src={company.logo}
                  alt=""
                  width={192}
                  class="h-auto w-24 shrink-0 object-contain"
                />
              ) : (
                <span class="text-center text-[0.72rem] leading-tight font-bold tracking-[0.05em] whitespace-nowrap text-night/70 uppercase transition-colors duration-300 hover:text-night/85">
                  {company.name}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
  <Container>
    <p id="regional-companies-notice" class="mt-4 text-center text-xs leading-relaxed text-night/70">
      {regionalCompaniesNotice}
    </p>
  </Container>
</section>

<style>
  /* La copia sólo existe para el bucle: sin marquesina, estorba. */
  .sponsors-track--clone {
    display: none;
  }

  @media (min-width: 64rem) {
    .sponsors-viewport {
      display: flex;
      overflow: hidden;
      gap: 2rem;
    }

    .sponsors-track {
      display: flex;
      flex: 0 0 auto;
      justify-content: space-around;
      min-width: 100%;
      animation: sponsors-scroll 45s linear infinite;
    }

    .sponsors-track--clone {
      display: flex;
    }

    /* Pausa al pasar el mouse o al tabular hacia un logo: si alguien quiere
       mirar una empresa, el movimiento deja de pelearle. */
    .sponsors-viewport:hover .sponsors-track,
    .sponsors-viewport:focus-within .sponsors-track {
      animation-play-state: paused;
    }
  }

  @keyframes sponsors-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - 2rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsors-track {
      animation: none;
      flex-wrap: wrap;
      min-width: 0;
      width: 100%;
    }

    .sponsors-track--clone {
      display: none;
    }
  }
</style>
