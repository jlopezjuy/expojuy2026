---
import { photos } from '../../data/photos';
import { pillars } from '../../data/site';
import ButtonLink from '../ui/ButtonLink.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="la-expo" class="bg-cream" aria-labelledby="la-expo-title">
  <div class="grid items-stretch lg:grid-cols-[minmax(0,38%)_minmax(0,62%)]">
    <div class="reveal flex flex-col justify-center px-gutter py-16 lg:py-20 xl:pl-[max(3.5rem,calc((100vw-96rem)/2+3.5rem))]">
      <SectionHeading
        eyebrow="La Expo"
        title="El encuentro que impulsa a"
        accent="Jujuy."
        id="la-expo-title"
        class="max-w-[26rem]"
      />

      <p class="text-body mt-6 max-w-[34ch] text-night/75">
        Empresas, emprendedores y destinos que muestran lo mejor de nuestra tierra al mundo.
      </p>

      <ul class="mt-10 flex items-start justify-between gap-3 sm:justify-start sm:gap-6">
        {
          pillars.map((pillar) => (
            <li class="flex min-w-0 flex-col items-start gap-2.5">
              <Icon name={pillar.icon} class="h-6 w-6 text-night" />
              <span class="text-[0.52rem] leading-tight font-bold tracking-[0.08em] text-night/80 uppercase">
                {pillar.label}
              </span>
            </li>
          ))
        }
      </ul>

      <ButtonLink href="#emprendimientos" class="mt-10 w-full sm:w-fit">Conocer más</ButtonLink>
    </div>

    <!-- Photo bleeds to the right edge and fades into the cream, as in the mockup. -->
    <figure class="relative min-h-[16rem] lg:min-h-[34rem]">
      <Photo
        photo={photos.expoGate}
        sizes="(min-width: 1024px) 62vw, 100vw"
        ratio={16 / 10}
        class="h-full w-full object-cover"
      />
      <div
        class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(to_right,var(--color-cream)_0%,rgba(247,239,225,0.55)_9%,rgba(247,239,225,0)_26%)] lg:block"
        aria-hidden="true"
      >
      </div>
      <figcaption class="sr-only">
        Ingreso al predio de ExpoJuy. Imagen de referencia pendiente de reemplazo por la fotografía
        oficial del arco de acceso.
      </figcaption>
    </figure>
  </div>
</section>
