---
import { agendaDays } from '../../data/site';
import { agendaItems, agendaTracks } from '../../data/agenda';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  /** Heading level, since this section is its own page (h1) yet reuse-safe. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h1' } = Astro.props;

const pillClass =
  'rounded-full border border-night/20 px-4 py-2 text-[0.62rem] font-bold tracking-[0.14em] whitespace-nowrap text-night/70 uppercase transition duration-300 ease-out hover:border-night/50 hover:text-night aria-pressed:border-night aria-pressed:bg-night aria-pressed:text-cream';

const dayFilters = [{ id: 'todos', label: 'Todos los días' }, ...agendaDays.map((d) => ({ id: d.day, label: `Día ${d.day} de Sept.` }))];
const trackFilters = [{ id: 'todos', label: 'Todas las temáticas' }, ...agendaTracks];
const trackById = new Map(agendaTracks.map((t) => [t.id, t]));
---

<section class="bg-cream pb-16 lg:pb-20" aria-labelledby="agenda-title">
  <Container width="normal">
    <div class="reveal">
      <SectionHeading
        eyebrow="Agenda y Cronograma"
        title="Programa Oficial"
        accent="Expo 2026."
        accentColor="magenta"
        as={headingLevel}
        id="agenda-title"
      />
      <p class="mt-6 max-w-[58ch] text-body text-night/75">
        Cuatro jornadas completas de conferencias magistrales, rondas internacionales de negocios, paneles técnicos, talleres participativos y espectáculos culturales.
      </p>
    </div>

    {/* Filtros de la Agenda */}
    <div class="reveal mt-10 flex flex-col gap-6" style="--reveal-delay:120ms">
      <div class="flex flex-col gap-3">
        <p class="eyebrow text-night/60">Filtrar por jornada</p>
        <div
          class="rail -mx-gutter px-gutter sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:[mask-image:none] sm:[-webkit-mask-image:none]"
          role="group"
          aria-label="Filtrar agenda por día"
          id="agenda-days"
        >
          {
            dayFilters.map((filter, i) => (
              <button
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls="agenda-grid"
                data-day={filter.id}
                class={pillClass}
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <p class="eyebrow text-night/60">Filtrar por temática</p>
        <div
          class="rail -mx-gutter px-gutter sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:[mask-image:none] sm:[-webkit-mask-image:none]"
          role="group"
          aria-label="Filtrar agenda por temática"
          id="agenda-tracks"
        >
          {
            trackFilters.map((filter, i) => (
              <button
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls="agenda-grid"
                data-track={filter.id}
                class={pillClass}
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>

      <p id="agenda-count" class="sr-only" role="status" aria-live="polite"></p>

      {/* Grilla de Sesiones */}
      <ul id="agenda-grid" class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          agendaItems.map((item, i) => {
            const track = trackById.get(item.trackId);
            return (
              <li
                data-day={item.day}
                data-track={item.trackId}
                class="reveal flex flex-col justify-between rounded-card border border-night/10 bg-cream-deep/60 p-6 transition-all duration-300 hover:border-night/30 hover:shadow-sm"
                style={`--reveal-delay:${(i % 6) * 60}ms`}
              >
                <div>
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-baseline gap-2">
                      <span class="font-display text-2xl font-bold text-night">{item.day}</span>
                      <span class="eyebrow text-night/70">{item.month}</span>
                    </div>
                    {track && (
                      <span class="rounded bg-night/10 px-2.5 py-1 text-[0.62rem] font-bold tracking-wider text-night uppercase">
                        {track.label}
                      </span>
                    )}
                  </div>

                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    <span class="rounded border border-gold/40 bg-gold/10 px-2.5 py-1 text-[0.68rem] font-bold tracking-wider text-night/90">
                      {item.time}
                    </span>
                    <span class="text-[0.68rem] font-semibold tracking-wide text-night/70 uppercase">
                      📍 {item.location}
                    </span>
                  </div>

                  <h2 class="font-display mt-3 text-lg font-bold text-night text-balance">
                    {item.title}
                  </h2>

                  {item.speaker && (
                    <p class="mt-1.5 text-xs font-semibold text-night/80">
                      Oradores: <span class="text-night/70 font-normal">{item.speaker}</span>
                    </p>
                  )}

                  <p class="mt-3 text-body text-night/75">
                    {item.note}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-8 rounded-card border border-night/10 bg-cream-deep/40 p-6 sm:p-8">
        <p class="text-xs leading-relaxed text-night/80">
          <strong>Información para asistentes:</strong> El ingreso a todas las conferencias, paneles y talleres en el Auditorio Principal y salas temáticas está incluido en tu entrada general a ExpoJuy 2026, por orden de llegada hasta agotar la capacidad de cada sala.
        </p>
      </div>
    </div>
  </Container>
</section>
