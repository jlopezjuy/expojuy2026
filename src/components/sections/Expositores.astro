---
import { expositores, rubrosExpositores } from '../../data/expositores';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Heading level, since this section is its own page (h1) yet reuse-safe. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h1' } = Astro.props;
---

<section class="bg-cream pt-28 pb-16 sm:pt-32 lg:pt-36 lg:pb-24" aria-labelledby="expositores-title">
  <Container width="normal">
    <div class="reveal">
      <SectionHeading
        eyebrow="Expositores"
        title="Directorio de"
        accent="Empresas."
        accentColor="magenta"
        as={headingLevel}
        id="expositores-title"
      />
      <p class="mt-6 max-w-[58ch] text-body text-night/75">
        Empresas, instituciones, cooperativas y polos productivos que representan la potencia económica, industrial y cultural de Jujuy.
      </p>
    </div>

    {/* Controles de Búsqueda y Filtros */}
    <div class="reveal mt-10 flex flex-col gap-6" style="--reveal-delay: 80ms">
      {/* Barra de Búsqueda */}
      <div class="relative max-w-xl">
        <label for="search-expositores" class="sr-only">Buscar expositor por nombre, rubro o stand</label>
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-night/50">
          <Icon name="search" class="h-5 w-5" />
        </div>
        <input
          type="search"
          id="search-expositores"
          placeholder="Buscar por empresa, rubro o stand..."
          class="w-full rounded-card border border-night/20 bg-cream-deep/80 py-3.5 pr-4 pl-11 text-body text-night placeholder:text-night/50 transition-colors focus:border-magenta focus:bg-cream focus:outline-none focus:ring-2 focus:ring-magenta/20"
        />
      </div>

      {/* Selector de Rubros */}
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por rubro">
        {
          rubrosExpositores.map((rubro, index) => (
            <button
              type="button"
              data-rubro-filter={rubro}
              class={`rounded-full px-4 py-2 text-[0.68rem] font-bold tracking-[0.14em] uppercase transition-all duration-300 ${
                index === 0
                  ? 'bg-night text-cream shadow-sm'
                  : 'border border-night/15 bg-cream-deep/60 text-night/80 hover:border-night/40 hover:bg-cream-deep'
              }`}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {rubro}
            </button>
          ))
        }
      </div>

      {/* Contador en vivo */}
      <div class="flex items-center justify-between border-b border-night/10 pb-4">
        <p id="expositores-counter" aria-live="polite" class="eyebrow text-night/70">
          Mostrando {expositores.length} expositores
        </p>
      </div>
    </div>

    {/* Grilla de Expositores */}
    <ul id="expositores-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        expositores.map((expositor, i) => (
          <li
            data-expositor-card
            data-rubro={expositor.rubro}
            data-search-text={`${expositor.nombre} ${expositor.rubro} ${expositor.pabellon} ${expositor.stand} ${expositor.descripcion}`.toLowerCase()}
            class="reveal flex flex-col justify-between rounded-card border border-night/10 bg-cream-deep/60 p-6 transition-all duration-300 hover:border-night/30 hover:shadow-sm"
            style={`--reveal-delay:${(i % 6) * 60}ms`}
          >
            <div>
              <div class="flex items-start justify-between gap-3">
                <span class="rounded bg-night/10 px-2.5 py-1 text-[0.62rem] font-bold tracking-wider text-night uppercase">
                  {expositor.rubro}
                </span>
                <span class="rounded border border-gold/40 bg-gold/10 px-2 py-0.5 text-[0.62rem] font-bold tracking-wider text-night/90">
                  Stand {expositor.stand}
                </span>
              </div>

              <h2 class="font-display mt-3 text-lg font-bold text-night">
                {expositor.nombre}
              </h2>

              <p class="mt-1 text-xs font-semibold tracking-wide text-night/60 uppercase">
                {expositor.pabellon}
              </p>

              <p class="mt-3 text-body text-night/75">
                {expositor.descripcion}
              </p>
            </div>

            <div class="mt-6 border-t border-night/10 pt-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-night/80 transition-colors hover:text-magenta">
                <Icon name="arrow-right" class="h-3.5 w-3.5 text-magenta" />
                {expositor.contacto}
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Mensaje de búsqueda vacía */}
    <div id="no-expositores" class="hidden mt-12 rounded-card border border-night/10 bg-cream-deep/60 p-10 text-center">
      <p class="font-display text-title text-night">No se encontraron expositores</p>
      <p class="mt-2 text-body text-night/70">
        Intentá con otro término de búsqueda o seleccioná "Todos" en los filtros de rubro.
      </p>
    </div>
  </Container>
</section>
