---
import { photos, type PhotoKey } from '../../data/photos';
import type { Product } from '../../data/site';
import Photo from '../ui/Photo.astro';

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const photo = photos[product.photo as PhotoKey];
---

<figure
  class="reveal group w-[52vw] overflow-hidden rounded-[3px] sm:w-[14rem] lg:w-[11.5rem]"
  data-category={product.category}
  style={`--reveal-delay:${index * 70}ms`}
>
  <div class="aspect-[4/5] overflow-hidden bg-cream-deep">
    <Photo
      photo={photo}
      ratio={4 / 5}
      sizes="(min-width: 1024px) 11.5rem, (min-width: 640px) 14rem, 52vw"
      maxWidth={640}
      class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
    />
  </div>
</figure>
