---
import { photos } from '../../data/photos';
import { event, heroCategories } from '../../data/site';
import Container from '../layout/Container.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import HeroCollage from './HeroCollage.astro';
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-night"
  aria-labelledby="hero-title"
>
  <!-- Backdrop is over-scaled so the parallax translation never reveals an edge. -->
  <div class="absolute inset-0 -z-20 scale-115" data-parallax data-depth="0.16">
    <Photo
      photo={photos.heroBackdrop}
      sizes="100vw"
      ratio={16 / 9}
      priority
      class="h-full w-full object-cover object-center [filter:saturate(1.12)_contrast(1.08)]"
    />
  </div>

  <!-- Cinematic grade: vignette top and bottom so header and copy stay legible. -->
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_bottom,rgba(4,12,20,0.72)_0%,rgba(4,12,20,0.1)_24%,rgba(4,12,20,0.34)_56%,rgba(4,12,20,0.93)_100%)]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative flex flex-1 flex-col pt-28 pb-8 sm:pt-32 lg:pt-[8vh] lg:pb-10">
    <!-- Title block: sits high and runs across the photograph. -->
    <div class="lg:mx-auto lg:w-[88%]">
      <p class="eyebrow flex flex-col gap-x-7 gap-y-0.5 text-white/85 sm:flex-row sm:justify-center">
        {event.eyebrow.map((line) => <span>{line}</span>)}
      </p>

      <h1
        id="hero-title"
        class="text-hero mt-2 text-center font-normal text-white sm:mt-1"
        style="letter-spacing:-0.015em; text-shadow:0 18px 60px rgba(4,12,20,0.5)"
      >
        JUJUY
      </h1>
    </div>

    <!-- Collage overlaps the title's right shoulder, as in the reference. -->
    <div
      class="pointer-events-none absolute top-[16%] right-gutter hidden w-[23%] max-w-[21rem] lg:block"
    >
      <div class="pointer-events-auto"><HeroCollage /></div>
    </div>

    <div
      class="mt-auto grid gap-8 pt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,46%)] lg:items-end lg:gap-10 xl:grid-cols-[minmax(0,1fr)_minmax(0,40%)]"
    >
      <!-- Dates and venue: bottom-left. -->
      <div class="order-2 lg:order-1">
        <p class="font-display text-2xl leading-tight font-semibold text-white sm:text-[1.7rem]">
          <span class="block">{event.datesShort}</span>
          <span class="block">{event.datesLong}</span>
        </p>
        <p
          class="mt-3 text-[0.66rem] leading-relaxed font-semibold tracking-[0.16em] text-white/75 uppercase"
        >
          <span class="block">{event.venue}</span>
          <span class="block">{event.city}</span>
        </p>
      </div>

      <!-- Statement: bottom-right, under the collage. -->
      <div class="order-1 lg:order-2">
        <p class="text-title font-display text-white text-balance">
          Conocé lo que<br class="hidden sm:inline" /> nace en nuestra tierra.
        </p>
        {/* Separators are pseudo-elements, and only on items that never start a
            line: two per row on phones, one continuous row from `sm`. */}
        <p
          class="eyebrow mt-4 flex max-w-[12.5rem] flex-wrap items-center gap-x-2.5 gap-y-1 text-white/80 sm:max-w-none"
        >
          {
            heroCategories.map((cat) => (
              <span class="whitespace-nowrap before:mr-2.5 before:text-white/40 even:before:content-['·'] sm:not-first:before:content-['·']">
                {cat}
              </span>
            ))
          }
        </p>
      </div>
    </div>

    <a
      href="#la-expo"
      class="group mx-auto mt-8 flex w-fit flex-col items-center gap-1.5 text-white/85 transition-colors duration-300 hover:text-white lg:mt-6"
    >
      <Icon name="arrow-down" class="h-4 w-4 motion-safe:animate-bounce" />
      <span class="flex items-center gap-3">
        <span class="eyebrow">Descubrí más</span>
        <span
          class="grid h-7 w-7 place-items-center rounded-full border border-white/40 transition-colors duration-300 group-hover:border-white group-hover:bg-white group-hover:text-night"
        >
          <Icon name="arrow-right" class="h-3 w-3" />
        </span>
      </span>
    </a>
  </Container>
</section>
